{
  "settings_version": 1,
  "output": {
    "directory_name": "Annotated_Events",
    "directory": null
  },
  "discovery": {
    "suffixes": ["_eeg.vhdr", "_eeg.edf", "_eeg.bdf"],
    "exclude_dir_names": ["derivatives", "Annotated_Events", ".git", ".electrotag"],
    "follow_symlinks": false
  },
  "filters": {
    "highpass_enabled": true,
    "highpass_hz": 1.0,
    "notch_enabled": true,
    "notch_hz": 50.0,
    "notch_harmonics": false,
    "method": "fir",
    "iir_order": 4,
    "locked": false
  },
  "display": {
    "duration_s": 10.0,
    "n_channels": 32,
    "scalings": {"eeg": 5e-05, "eog": 0.00015, "ecg": 0.0005, "emg": 0.0001, "misc": 0.001},
    "theme": "light",
    "overview_mode": "empty",
    "channel_colours": "off"
  },
  "loading": {
    "preload_memory_limit_mb": 2048,
    "hash_source_files": true,
    "apply_channel_types_from_bids": true,
    "show_bids_bad_channels": true
  },
  "channels": {
    "hide": [
      "TIME_STAMP_s", "TIME_STAMP_ms", "OR_TIME_STAMP_s", "OR_TIME_STAMP_ms", "COUNTER", "INTERPOLATED",
      "RAW_CQ", "BATTERY", "BATTERY_PERCENT", "MarkerIndex", "MarkerType", "MarkerValueInt", "MARKER_HARDWARE",
      "CQ_*", "EQ_*"
    ],
    "types": {}
  },
  "selection": {
    "strategy": "random",
    "seed": null
  },
  "locks": {
    "recording_lock_stale_hours": 2.0,
    "register_lock_timeout_s": 30.0
  },
  "logging": {
    "interactions": true,
    "pointer_hz": 5.0,
    "idle_after_s": 30.0
  },
  "annotation": {
    "min_duration_samples": 1,
    "allow_revisions": true,
    "allow_reviews": true,
    "show_reviews_to_annotators": true,
    "merge_overlapping": true,
    "break_reminder_minutes": 50,
    "idle_pause_minutes": 3,
    "coverage_check": "warn",
    "confidence": "optional",
    "quick_labels": [
      "Eye-blink-artifact", "Horizontal-eye-movement-artifact", "EMG-artifact", "Movement-artifact",
      "Electrode-pops-artifact", "Chewing-artifact", "ECG-artifact", "Line-noise-artifact", "Data-artifact"
    ]
  },
  "gamification": {
    "enabled": true,
    "leaderboard": true,
    "leaderboard_viewed_only": false
  },
  "review": {
    "corrections": true,
    "show_corrections_to_annotators": true,
    "k_default": 2,
    "show_outcomes_to_annotators": true,
    "reason_required": "always",
    "matching": {"match_criterion": "iou", "iou_threshold": 0.2, "onset_tolerance_s": 0.5,
                 "offset_tolerance_s": 0.5, "channel_jaccard": 0.5},
    "gold_min_items": 3
  },
  "training": {
    "skippable": ["tour", "snippets", "guided", "practice"],
    "gate": "met",
    "tour": true,
    "snippets_quiz_required": false
  },
  "replay": {
    "enabled": true,
    "trainees_watch_experts": true,
    "trainees_see_crowd": false
  },
  "questionnaire": {
    "enabled": true,
    "demographics": true,
    "questions": [
      {"id": "datasets_analysed", "group": "experience", "text": "How many EEG datasets have you analysed?", "type": "choice", "required": true, "options": ["0", "1–2", "3–10", "11–30", "31–100", "Over 100"], "help": "Count each study or collection of recordings you have processed or analysed as one dataset."},
      {"id": "eeg_years", "group": "experience", "text": "How many years have you worked with EEG?", "type": "choice", "required": true, "options": ["Less than 1", "1–2", "3–5", "6–10", "More than 10"]},
      {"id": "annotation_hours", "group": "experience", "text": "About how many hours have you spent marking artifacts in EEG?", "type": "choice", "required": true, "options": ["None", "Fewer than 10", "10–50", "51–200", "201–1000", "More than 1000"]},
      {"id": "artifact_training", "group": "experience", "text": "Have you had formal training in recognising EEG artifacts?", "type": "choice", "required": true, "options": ["No formal training", "Informal training from colleagues", "A course or workshop", "Clinical EEG training or accreditation", "Other"], "other_option": "Other"},
      {"id": "eeg_systems", "group": "experience", "text": "Which EEG systems have you used?", "type": "multi", "required": true, "options": ["BioSemi", "Brain Products", "EGI (Magstim EGI)", "ANT Neuro", "g.tec", "Neuroscan (Compumedics)", "A clinical system (such as Natus or Nihon Kohden)", "A consumer system (such as Emotiv or Muse)", "OpenBCI", "None yet", "Other"], "other_option": "Other", "help": "Choose all that apply."},
      {"id": "eeg_setting", "group": "experience", "text": "Is your EEG experience clinical or research?", "type": "choice", "required": true, "options": ["Research", "Clinical", "Both", "Neither yet"]},
      {"id": "confidence", "group": "experience", "text": "How confident are you at recognising artifacts in EEG?", "type": "choice", "required": true, "options": ["1 (not at all confident)", "2", "3", "4", "5 (very confident)"]},
      {"id": "career_stage", "group": "career", "text": "What is your career stage?", "type": "choice", "required": true, "options": ["Undergraduate", "Master's", "PhD", "Postdoc", "Faculty", "Clinician", "EEG technologist", "Industry", "Other"], "other_option": "Other"},
      {"id": "discipline", "group": "career", "text": "What is your discipline?", "type": "choice", "required": true, "options": ["Neuroscience", "Psychology", "Engineering", "Medicine", "Other"], "other_option": "Other"},
      {"id": "country", "group": "career", "text": "Which country do you work in?", "type": "text", "required": true},
      {"id": "age_band", "group": "demographics", "text": "What is your age?", "type": "choice", "required": true, "options": ["18–24", "25–34", "35–44", "45–54", "55–64", "65 or over"]},
      {"id": "gender", "group": "demographics", "text": "What is your gender?", "type": "choice", "required": true, "options": ["Woman", "Man", "Non-binary", "Prefer to self-describe"], "other_option": "Prefer to self-describe"},
      {"id": "first_language", "group": "demographics", "text": "What is your first language?", "type": "text", "required": true}
    ],
    "contacts": {"full_name": "required", "email": "required", "phone": "optional", "institution": "optional"}
  }
}
